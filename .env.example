# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://skyhigh:skyhigh@localhost:5432/skyhigh

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-here

# Seat Hold
SEAT_HOLD_TTL_SECONDS=120
SEAT_MAP_CACHE_TTL_MS=2000

# Baggage & Payment
EXCESS_FEE_PER_KG=10.00
MAX_BAGGAGE_WEIGHT_KG=25

# Rate Limiting
RATE_LIMIT_WINDOW_MS=2000
RATE_LIMIT_MAX_REQUESTS=50

# External Services
PAYMENT_SERVICE_URL=http://stub-payment:3001
WEIGHT_SERVICE_URL=http://stub-weight:3002
NOTIFICATION_SERVICE_URL=http://stub-notification:3003

# Payment Retry
PAYMENT_TIMEOUT_MS=5000
PAYMENT_MAX_RETRIES=3
PAYMENT_INITIAL_BACKOFF_MS=500

# Weight Service
WEIGHT_SERVICE_TIMEOUT_MS=5000

# Notification Service
NOTIFICATION_TIMEOUT_MS=5000

# Background Jobs
SWEEP_INTERVAL_SECONDS=30

# Data Retention
ABUSE_RETENTION_DAYS=90
